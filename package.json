{
  "name": "churnlens",
  "displayName": "ChurnLens",
  "version": "1.0.0",
  "description": "Visualizes code churn in a Churn Explorer",
  "categories": [
    "Other"
  ],
  "license": "MIT",
  "author": {
    "name": "Paul Melero"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/graficos/churnlens-extension.git"
  },
  "publisher": "paulmelero",
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "vp build && vp pack",
    "vscode:publish": "vsce package --no-dependencies && vsce publish --no-dependencies",
    "build": "vp build && vp pack",
    "compile": "vp build && vp pack",
    "watch": "vp build --watch & vp pack --watch",
    "check": "vp check",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test": "vp test"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vscode/codicons": "^0.0.44",
    "@vscode/vsce": "^4.0.0",
    "daisyui": "^5.7.47",
    "simple-git": "^3.19.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.1.3",
    "vite-plus": "^1.1.0",
    "vue": "^3.5.43"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "churnlens-explorer",
          "title": "ChurnLens",
          "icon": "resources/icon2.svg"
        }
      ]
    },
    "views": {
      "churnlens-explorer": [
        {
          "id": "churnlens.sidebar",
          "name": "Churn Explorer",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "churnlens.openConfig",
        "title": "ChurnLens: Open Configuration"
      },
      {
        "command": "churnlens.refresh",
        "title": "ChurnLens: Refresh Stats"
      },
      {
        "command": "churnlens.openTrend",
        "title": "ChurnLens: Open Trend"
      },
      {
        "command": "churnlens.openInGithub",
        "title": "See git history in github"
      }
    ],
    "menus": {
      "webview/context": [
        {
          "command": "churnlens.openInGithub",
          "when": "webviewId == churnlens.sidebar && webviewSection == fileItem"
        }
      ]
    },
    "colors": [
      {
        "id": "churnlens.level1",
        "description": "Churn Level 1 (Low)",
        "defaults": {
          "dark": "#90EE90",
          "light": "#90EE90",
          "highContrast": "#90EE90"
        }
      },
      {
        "id": "churnlens.level2",
        "description": "Churn Level 2",
        "defaults": {
          "dark": "#ADFF2F",
          "light": "#ADFF2F",
          "highContrast": "#ADFF2F"
        }
      },
      {
        "id": "churnlens.level3",
        "description": "Churn Level 3",
        "defaults": {
          "dark": "#FFD700",
          "light": "#FFD700",
          "highContrast": "#FFD700"
        }
      },
      {
        "id": "churnlens.level4",
        "description": "Churn Level 4",
        "defaults": {
          "dark": "#FFA500",
          "light": "#FFA500",
          "highContrast": "#FFA500"
        }
      },
      {
        "id": "churnlens.level5",
        "description": "Churn Level 5",
        "defaults": {
          "dark": "#FF4500",
          "light": "#FF4500",
          "highContrast": "#FF4500"
        }
      },
      {
        "id": "churnlens.level6",
        "description": "Churn Level 6 (High)",
        "defaults": {
          "dark": "#FF0000",
          "light": "#FF0000",
          "highContrast": "#FF0000"
        }
      }
    ],
    "configuration": {
      "title": "ChurnLens",
      "properties": {
        "churnlens.rangePreset": {
          "type": "string",
          "enum": [
            "2d",
            "3d",
            "7d",
            "30d",
            "custom"
          ],
          "enumDescriptions": [
            "Last 2 days",
            "Last 3 days",
            "Last 7 days",
            "Last 30 days",
            "Use churnlens.rangeStart and churnlens.rangeEnd"
          ],
          "default": "30d",
          "description": "Time window for churn calculation."
        },
        "churnlens.rangeStart": {
          "type": "string",
          "default": "",
          "description": "Custom range start date (YYYY-MM-DD). Used when churnlens.rangePreset is 'custom'."
        },
        "churnlens.rangeEnd": {
          "type": "string",
          "default": "",
          "description": "Custom range end date (YYYY-MM-DD). Used when churnlens.rangePreset is 'custom'."
        },
        "churnlens.commitLabels": {
          "type": "string",
          "default": "feat,fix,docs,style,refactor,perf,test,build,ci,chore,revert",
          "description": "Comma separated Conventional Commit labels used to group churn. Defaults to the Angular convention."
        },
        "churnlens.hideRoot": {
          "type": "boolean",
          "default": true,
          "description": "Hide the root project folder from the Churn Explorer."
        },
        "churnlens.baseline": {
          "type": "string",
          "enum": [
            "auto",
            "tags",
            "merges",
            "time"
          ],
          "enumDescriptions": [
            "Semver tags, else merges, else time buckets",
            "Bucket commits between semver tags",
            "Bucket commits between merge commits",
            "Bucket commits by day, week or month"
          ],
          "default": "auto",
          "description": "How the trend groups churn into periods."
        }
      }
    }
  },
  "activationEvents": [],
  "icon": "public/logo.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "url": "https://github.com/graficos/churnlens-extension"
}
